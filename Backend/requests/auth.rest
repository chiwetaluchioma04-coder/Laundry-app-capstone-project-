@baseUrl = http://localhost:5000/api

### 1. Register a New User as customer
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.test@example.com",
  "password": "password123",
  "phone": "+1234567890",
  "address": "123 Main Street"
}

### 2. Login as customer
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john.test@example.com",
  "password": "newpassword123"
}

### 3. Forgot Password (Request Reset Token)
# @name forgotPassword
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "john.test@example.com"
}

### 4. Reset Password
# Replace the resetToken value with the token returned from the forgot-password request above
@resetToken = "353e6315-5acb-4688-96ce-e9fc28370c68"

POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "resetToken": {{resetToken}},
  "password": "newpassword123"
}
